{
  "id": "/",
  "name": "GifTap",
  "short_name": "GifTap",
  "description": "Fast dark-mode PWA Share Overlay for grabbing TikTok, Instagram, and X GIFs as MP4.",
  "display": "standalone",
  "start_url": "/",
  "scope": "/",
  "theme_color": "#000000",
  "background_color": "#000000",
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/?share=1",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
